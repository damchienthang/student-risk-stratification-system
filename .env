# Biến môi trường (Config)

# Server config
HOST=0.0.0.0
PORT=8000
DEBUG=true

# Model config
MODEL_NAME=lightgbm
MODELS_DIR=models

# App config
APP_NAME=Student Risk Stratification System
APP_VERSION=1.0.0

# SMTP Config for Demo Email (Dùng Gmail + App Password)
# Bước 1: Vào myaccount.google.com > Bảo mật > Bật Xác minh 2 bước (qua SĐT là được)
# Bước 2: Tìm kiếm "App Passwords" > Chọn "Other" > Đặt tên "RiskSight" > Copy mật khẩu 16 ký tự
# Bước 3: Điền vào đây (KHÔNG dùng mật khẩu Google chính, dùng App Password)
SMTP_EMAIL=Your-email
SMTP_PASSWORD=Your-Password
